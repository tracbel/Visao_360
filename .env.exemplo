# Copie para .env (na raiz do repositorio) e preencha na SUA estacao. Nunca versione o .env:
# o .gitignore bloqueia .env e .env.*, com excecao explicita para este arquivo.
#
# Este arquivo so tem NOMES. Valor de senha, token ou segredo nunca entra aqui, nem em documento,
# issue, log ou URL (documento 46, regra R-11). Para conferir que nada vazou para o Git:
#     ./scripts/seguranca/varrer-segredos.ps1
#
# O banco LOCAL de desenvolvimento tem arquivo proprio: infra/.env (modelo em infra/.env.exemplo).
#
# Como cada chave chega ao codigo: o script indicado le daqui e repassa ao processo como variavel de
# ambiente no formato Secao__Chave, que o .NET le como Secao:Chave. Nada disso e impresso.

# -----------------------------------------------------------------------------------------------
# Protheus (TOTVS) — API REST (faturamento SD2 e cadastro SA1). Somente leitura.
# Uso hoje: scripts/protheus/_comum.ps1 (extracoes da estacao).
# Na carga (Tracbel.Crm.Carga) a credencial e lida de Protheus__Base / Protheus__Usuario /
# Protheus__Senha. PENDENCIA: o scripts/deploy/publicar.ps1 ainda NAO repassa estas duas chaves ao
# servidor (issue [018a], GitHub #18).
# -----------------------------------------------------------------------------------------------
TOTVS_API_USER_PROD=
TOTVS_API_PASSWORD_PROD=

# -----------------------------------------------------------------------------------------------
# Protheus (TOTVS) — SQL direto, so para conferir o dono de um chassi (tabela VV1) na sincronizacao
# do ART. O login tem db_owner no ERP: o codigo usa SO SELECT, e assim deve continuar.
# Uso: scripts/deploy/publicar.ps1 (-> ProtheusBanco__*) e scripts/integracao/rodar-carga-do-art.ps1.
# -----------------------------------------------------------------------------------------------
TOTVS_DB_SERVER=
TOTVS_DB_PORT=
TOTVS_DB_DATABASE=
TOTVS_DB_USER=
TOTVS_DB_PASSWORD=
# Sem uso no repositorio (a conexao e sempre SQL Server pelo Microsoft.Data.SqlClient).
TOTVS_DB_DRIVER=

# -----------------------------------------------------------------------------------------------
# ART — view MySQL de vendas de maquina, sessao READ ONLY. O servico do ART esta DESABILITADO.
# Uso: scripts/deploy/publicar.ps1 (-> Art__Servidor, Art__Porta, Art__Banco, Art__Usuario,
# Art__Senha, Art__Visao) e scripts/integracao/rodar-carga-do-art.ps1.
# -----------------------------------------------------------------------------------------------
ART_DB_SERVER=
ART_DB_PORT=
ART_DB_DATABASE=
ART_DB_USER=
ART_DB_PASSWORD=
ART_VIEW=
# Sem uso no repositorio (o conector e sempre MySQL).
ART_DB_TIPO=

# -----------------------------------------------------------------------------------------------
# Entra ID — login da API. A API le Entra__TenantId, Entra__ClientId e Entra__ClientSecret
# (e, opcional, Entra__GrupoPermitido), configurados no servidor. Nenhum script le estas chaves hoje:
# ficam aqui como referencia da estacao.
# -----------------------------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# -----------------------------------------------------------------------------------------------
# API Gestao de Negocios — paineis analiticos, somente leitura (documento 46, secao 5).
# Autenticacao: Authorization: Bearer <chave>. NUNCA na URL, nunca em log.
# A chave e UNICA para a API inteira: troca-la revoga todos os consumidores de uma vez. A rotacao e
# pedida a equipe dona da API (issue [001], GitHub #1).
# Sem uso no codigo ainda. Quando o cliente HTTP existir (issue [013], GitHub #13), o publicar.ps1
# passa a repassar -> GestaoDeNegocios__Base e GestaoDeNegocios__Chave.
# Certificado TLS interno: instalar a CA no servidor; nunca desligar a validacao.
# -----------------------------------------------------------------------------------------------
GESTAO_NEGOCIOS_API_URL=
GESTAO_NEGOCIOS_API_TOKEN=
