# Copie este arquivo para infra/.env e ajuste os valores.
#
# AS DUAS SENHAS ABAIXO SAO PLACEHOLDER, E TEM DE SER TROCADAS. Elas ja foram um valor real
# neste arquivo; foram removidas antes do primeiro commit, porque senha em arquivo versionado
# fica no historico do git para sempre — mesmo depois de apagada do arquivo. O container recusa
# senha fraca no boot, entao o erro aparece na hora se alguem esquecer de trocar.
# NUNCA versione infra/.env — o .gitignore ja bloqueia (.env e .env.*), com excecao explicita
# para este .env.exemplo. `subir-banco.ps1` cria o infra/.env a partir daqui na primeira vez.
#
# Este arquivo so tem o banco LOCAL do container. As credenciais das integracoes (Protheus,
# ART, Entra ID e API Gestao de Negocios) ficam no .env da RAIZ do repositorio, com os nomes
# em .env.exemplo na raiz. Sao dois arquivos de proposito: nao misture (doc 05, secao 11A).

# Senha do 'sa' do SQL Server do container, so para desenvolvimento local.
# O compose FALHA se esta variavel nao existir — nao ha valor padrao de proposito.
# O SQL Server EXIGE senha forte: 8 caracteres ou mais, com maiuscula, minuscula, digito e
# simbolo. Senha fraca faz o container morrer no boot sem criar banco nenhum.
DB_SENHA=DEFINA-UMA-SENHA-FORTE-AQUI

# Login da aplicacao, criado por subir-banco.ps1 e dono do banco de desenvolvimento.
# Nunca e o 'sa': o 'sa' so existe aqui porque o container precisa de um administrador.
DB_USUARIO=TracbelCrm

# Senha do login da aplicacao. Mesma exigencia de forca do 'sa'.
DB_SENHA_APLICACAO=DEFINA-OUTRA-SENHA-FORTE-AQUI

# Nome do banco. PascalCase, como todo identificador do projeto
# (docs/projeto/15-GLOSSARIO-E-NOMES.md).
DB_NOME=TracbelCrm

# Colacao do banco. CI = ignora caixa, AI = ignora acento — e o que faz "Jose" encontrar
# "Jose" com acento e o que impede dois rotulos que so diferem em acento de conviverem.
# Documento 14, regra 9.5, e documento 20, secao 4.
DB_COLACAO=Latin1_General_CI_AI

# Porta do SQL Server exposta no host. 1433 e a padrao e esta livre nesta maquina;
# as portas 5432 a 5440 estao ocupadas e por isso nao sao usadas.
DB_PORTA=1433

# Fuso do container. O dado e gravado sempre em UTC (o tipo de valor DataHoraUtc garante
# isso); isto so muda como o log do servidor exibe a hora.
TZ=America/Sao_Paulo

# Porta do Adminer, quando voce subir o profile de administracao:
#     docker compose -f infra/docker-compose.yml --profile administracao up -d
# 8080 ja esta ocupada nesta maquina — por isso 8081.
ADMINER_PORTA=8081

# A cadeia de conexao que a API e a carga usam. Montada a partir dos valores acima; ela NAO mora
# no appsettings.json, pela mesma razao das senhas.
#
#     $env:ConnectionStrings__Crm = "Server=localhost,$env:DB_PORTA;Database=$env:DB_NOME;" +
#         "User Id=$env:DB_USUARIO;Password=$env:DB_SENHA_APLICACAO;" +
#         "TrustServerCertificate=True;MultipleActiveResultSets=False"
#
# TrustServerCertificate=True vale SO para o container, que usa certificado autoassinado.
