<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tracbel.Crm.Dominio\Tracbel.Crm.Dominio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O cliente de SQL Server, para ler o banco do sistema legado por ADO.NET puro.

      POR QUE ADO.NET E NAO EF CORE: mapear as tabelas do legado no EF significaria descrever
      GE_Pessoa (76 colunas) e IV_ClientePropr (51 colunas) como entidades — e entidade e uma
      coisa que a gente mantem. O que a ponte precisa e de uma consulta de leitura por endpoint,
      com a traducao acontecendo na fronteira. Quando o legado morrer, apaga-se a pasta Vortice
      e nao sobra modelo nenhum para limpar.

      A MESMA versao ja usada em Tracbel.Crm.Arquitetura.Testes — nao entra versao nova na solucao.
    -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O cliente de MySQL, para ler a view de vendas de maquina do ART (documento 35, secao 10).

      POR QUE ESTE E NAO O CONECTOR DA ORACLE: MySqlConnector e MIT, assincrono de verdade e sem
      dependencia nativa. A leitura e uma consulta so, com sessao declarada READ ONLY — o mesmo
      principio do Vortice: ADO.NET puro, traducao na fronteira, nenhum modelo do sistema de fora.
    -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
