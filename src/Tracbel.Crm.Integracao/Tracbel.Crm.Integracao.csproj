<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tracbel.Crm.Dominio\Tracbel.Crm.Dominio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O cliente de SQL Server, para ler o banco do sistema legado por ADO.NET puro.

      POR QUE ADO.NET E NAO EF CORE: mapear as tabelas do legado no EF significaria descrever
      GE_Pessoa (76 colunas) e IV_ClientePropr (51 colunas) como entidades — e entidade e uma
      coisa que a gente mantem. O que a ponte precisa e de uma consulta de leitura por endpoint,
      com a traducao acontecendo na fronteira. Quando o legado morrer, apaga-se a pasta Vortice
      e nao sobra modelo nenhum para limpar.

      A MESMA versao ja usada em Tracbel.Crm.Arquitetura.Testes — nao entra versao nova na solucao.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
