<Project>

  <!--
    Configurações comuns a TODOS os projetos da solução.
    Mexer aqui vale para tudo — é o único lugar onde a versão do .NET é declarada.
  -->
  <PropertyGroup>
    <!--
      ALVO: net10.0 — LTS, com suporte até 14/11/2028 (issue 084, migrado em 19/09/2026).

      O esqueleto nasceu em net9.0 porque era o único SDK da estação. O .NET 9 é STS e sai
      de suporte em 10/11/2026; o 8, na mesma data. A troca foi uma linha, como estava
      previsto — e o que custou foram as versões dos pacotes, todas em 10.0.12.

      A publicação é self-contained (`scripts/deploy/publicar.ps1`), então o servidor NÃO
      precisa ganhar runtime novo: o pacote leva o dele.
    -->
    <TargetFramework>net10.0</TargetFramework>

    <LangVersion>latest</LangVersion>

    <!-- Referências nulas explícitas. Evita metade dos NullReferenceException. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Warning é erro. Um aviso ignorado hoje é um bug em produção depois — e é assim
      que um sistema chega ao estado do Vórtice, onde uma falha crítica de integração
      é registrada como "Warning" e ninguém olha.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      AUDITORIA DE PACOTE NO RESTORE (issue 059).

      `all` inclui a dependência TRANSITIVA, que é onde a vulnerabilidade costuma morar: quem chega
      pelo pacote que o seu pacote arrasta não aparece em nenhum .csproj. `low` faz o NuGet RELATAR
      tudo; quem decide o que barra é a linha seguinte.

      Alto e crítico (NU1903, NU1904) viram erro pela regra geral "warning é erro" acima. Baixo e
      moderado (NU1901, NU1902) ficam como aviso de propósito: barrar tudo travaria o repositório em
      achados que muitas vezes não têm correção publicada, e o time aprenderia a ignorar o bloqueio —
      que é o pior resultado possível. Eles aparecem na tabela do job `seguranca`.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>

    <!-- Documentação XML obrigatória no código público (só nos projetos de src). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Português do Brasil como cultura neutra das mensagens do domínio. -->
    <NeutralLanguage>pt-BR</NeutralLanguage>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Nos projetos de teste, XML doc não faz sentido e CS1591 vira ruído. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Testes'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
